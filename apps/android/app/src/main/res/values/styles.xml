<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shapes -->
    <style name="ShapeAppearance.LG.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_s</item>
    </style>
    <style name="ShapeAppearance.LG.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_m</item>
    </style>
    <style name="ShapeAppearance.LG.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_l</item>
    </style>
    <style name="ShapeAppearance.LG.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_xl</item>
        <item name="cornerSizeTopRight">@dimen/radius_xl</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="ShapeAppearance.LG.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.LG.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LG.Medium</item>
        <item name="android:textAppearance">@style/TextAppearance.LG.Label</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
    </style>
    <style name="Widget.LG.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LG.Medium</item>
        <item name="android:textAppearance">@style/TextAppearance.LG.Label</item>
        <item name="strokeColor">@color/lg_outline</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
    </style>
    <style name="Widget.LG.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.LG.Label</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LG.Small</item>
    </style>
    <style name="Widget.LG.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LG.Medium</item>
        <item name="android:textAppearance">@style/TextAppearance.LG.Label</item>
        <item name="iconGravity">textStart</item>
    </style>
    <style name="Widget.LG.Button.Gold" parent="Widget.LG.Button">
        <item name="backgroundTint">@color/brand_gold</item>
        <item name="android:textColor">@color/brand_navy</item>
        <item name="iconTint">@color/brand_navy</item>
    </style>
    <style name="Widget.LG.Button.Small" parent="Widget.LG.Button.Tonal">
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textAppearance">@style/TextAppearance.LG.Caption</item>
    </style>

    <!-- Inputs -->
    <style name="Widget.LG.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_m</item>
        <item name="boxStrokeColor">@color/lg_primary</item>
        <item name="boxBackgroundColor">@color/lg_surface</item>
        <item name="hintTextAppearance">@style/TextAppearance.LG.Caption</item>
        <item name="errorTextAppearance">@style/TextAppearance.LG.Caption</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.LG.Caption</item>
    </style>
    <style name="Widget.LG.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_m</item>
        <item name="boxStrokeColor">@color/lg_primary</item>
        <item name="boxBackgroundColor">@color/lg_surface</item>
    </style>
    <style name="Widget.LG.TextInput.Search" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_m</item>
        <item name="boxBackgroundColor">@color/lg_surface_container_high</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintEnabled">false</item>
        <item name="startIconDrawable">@drawable/ic_search</item>
        <item name="endIconMode">clear_text</item>
    </style>

    <!-- Cards -->
    <style name="Widget.LG.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/lg_card</item>
        <item name="strokeColor">@color/lg_outline_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LG.Large</item>
    </style>
    <style name="Widget.LG.Card.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/lg_surface_container</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LG.Large</item>
    </style>

    <!-- Chips -->
    <style name="Widget.LG.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAppearance">@style/TextAppearance.LG.Caption</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LG.Pill</item>
        <item name="chipMinHeight">36dp</item>
    </style>
    <style name="Widget.LG.Chip.Assist" parent="Widget.Material3.Chip.Assist">
        <item name="android:textAppearance">@style/TextAppearance.LG.Caption</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LG.Pill</item>
        <item name="chipMinHeight">34dp</item>
    </style>

    <!-- Bars -->
    <style name="Widget.LG.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="titleTextAppearance">@style/TextAppearance.LG.Title</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.LG.Caption</item>
        <item name="android:background">@color/lg_background</item>
        <item name="titleCentered">false</item>
    </style>
    <style name="Widget.LG.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemTextAppearanceActive">@style/TextAppearance.LG.Caption</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.LG.Caption</item>
        <item name="backgroundTint">@color/lg_surface</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.LG.NavIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
    <style name="Widget.LG.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/lg_secondary_container</item>
    </style>
    <style name="Widget.LG.Tabs" parent="Widget.Material3.TabLayout">
        <item name="tabTextAppearance">@style/TextAppearance.LG.Label</item>
        <item name="tabMode">scrollable</item>
        <item name="tabGravity">start</item>
        <item name="android:background">@color/lg_background</item>
    </style>
    <style name="Widget.LG.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="shapeAppearance">@style/ShapeAppearance.LG.Medium</item>
    </style>

    <!-- Text styles used in layouts -->
    <style name="LG.Text.SectionTitle" parent="">
        <item name="android:textAppearance">@style/TextAppearance.LG.Subtitle</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="LG.Text.Muted" parent="">
        <item name="android:textAppearance">@style/TextAppearance.LG.BodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="LG.Badge" parent="">
        <item name="android:textAppearance">@style/TextAppearance.LG.Caption</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
