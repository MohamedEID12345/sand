<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <include
        android:id="@+id/app_bar"
        layout="@layout/view_appbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_2xl">

            <TextView
                style="@style/LG.Text.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_appearance"
                android:layout_marginTop="@dimen/space_xs"
                android:layout_marginBottom="@dimen/space_s" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/theme_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/theme_system"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/theme_system"
                    app:icon="@drawable/ic_settings" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/theme_light"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/theme_light"
                    app:icon="@drawable/ic_light" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/theme_dark"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/theme_dark"
                    app:icon="@drawable/ic_dark" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                style="@style/LG.Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_language_note"
                android:layout_marginTop="@dimen/space_s"
                android:textSize="12sp" />

            <TextView
                style="@style/LG.Text.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_notifications"
                android:layout_marginTop="@dimen/space_l"
                android:layout_marginBottom="@dimen/space_s" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_l"
                        android:paddingTop="@dimen/space_m"
                        android:paddingEnd="@dimen/space_m"
                        android:paddingBottom="@dimen/space_m">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_notifications_toggle"
                                android:textAppearance="@style/TextAppearance.LG.Label"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                style="@style/LG.Text.Muted"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_notifications_desc"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/notifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/lg_outline_variant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_l"
                        android:paddingTop="@dimen/space_m"
                        android:paddingEnd="@dimen/space_m"
                        android:paddingBottom="@dimen/space_m">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_reminders_toggle"
                                android:textAppearance="@style/TextAppearance.LG.Label"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                style="@style/LG.Text.Muted"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_reminders_desc"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/reminders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/LG.Text.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_about"
                android:layout_marginTop="@dimen/space_l"
                android:layout_marginBottom="@dimen/space_s" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_xs">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/privacy"
                        style="@style/Widget.LG.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/more_privacy"
                        app:icon="@drawable/ic_shield"
                        android:gravity="center_vertical|start"
                        android:paddingStart="@dimen/space_l" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/terms"
                        style="@style/Widget.LG.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/more_terms"
                        app:icon="@drawable/ic_document"
                        android:gravity="center_vertical|start"
                        android:paddingStart="@dimen/space_l" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/officePortal"
                        style="@style/Widget.LG.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_office_portal"
                        app:icon="@drawable/ic_open"
                        android:gravity="center_vertical|start"
                        android:paddingStart="@dimen/space_l" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/website"
                        style="@style/Widget.LG.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_website"
                        app:icon="@drawable/ic_open"
                        android:gravity="center_vertical|start"
                        android:paddingStart="@dimen/space_l" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/version"
                style="@style/LG.Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center" />

            <TextView
                style="@style/LG.Text.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_account"
                android:layout_marginTop="@dimen/space_l"
                android:layout_marginBottom="@dimen/space_s" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_xs">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/logout"
                        style="@style/Widget.LG.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/action_logout"
                        app:icon="@drawable/ic_logout"
                        android:gravity="center_vertical|start"
                        android:paddingStart="@dimen/space_l" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/delete_account"
                        style="@style/Widget.LG.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/delete_account_title"
                        app:icon="@drawable/ic_delete"
                        android:gravity="center_vertical|start"
                        android:paddingStart="@dimen/space_l"
                        android:textColor="@color/tone_danger"
                        app:iconTint="@color/tone_danger" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
