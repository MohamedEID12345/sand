<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_l">

        <LinearLayout
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_icon_tile"
            android:backgroundTint="@color/tone_gold_bg"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pack_credits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LG.Title"
                android:textColor="@color/tone_gold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_credit"
                android:textAppearance="@style/TextAppearance.LG.Caption"
                android:textColor="@color/tone_gold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pack_badge"
                style="@style/LG.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pack_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LG.Subtitle"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/pack_bonus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LG.Caption"
                android:textColor="@color/tone_success"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pack_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.LG.Label"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pack_buy"
            style="@style/Widget.LG.Button.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pack_buy" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
