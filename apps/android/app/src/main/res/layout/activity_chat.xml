<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lg_background">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_s" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/intro"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_2xl">

                <FrameLayout
                    android:id="@+id/intro_tile"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginTop="@dimen/space_2xl"
                    android:background="@drawable/bg_icon_tile">

                    <ImageView
                        android:id="@+id/intro_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:id="@+id/intro_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:textAppearance="@style/TextAppearance.LG.Title"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/intro_desc"
                    style="@style/LG.Text.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:maxWidth="340dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xl"
                    android:text="@string/chat_suggestions"
                    android:textAppearance="@style/TextAppearance.LG.Caption"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/intro_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.legalguide.app.ui.common.StateView
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_s">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/upload_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/attachments_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/attachment_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/attach"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/chat_attach"
                app:icon="@drawable/ic_attach"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginEnd="@dimen/space_s"
                android:layout_weight="1"
                android:background="@drawable/bg_composer"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="6"
                android:minHeight="48dp"
                android:paddingStart="@dimen/space_l"
                android:paddingTop="@dimen/space_m"
                android:paddingEnd="@dimen/space_l"
                android:paddingBottom="@dimen/space_m"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.LG.Body"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/send"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/chat_send"
                app:icon="@drawable/ic_send" />
        </LinearLayout>

        <TextView
            android:id="@+id/disclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/ai_disclaimer_short"
            android:textAppearance="@style/TextAppearance.LG.Caption"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
