<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clickable="true"
    android:focusable="false">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/state_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        app:indicatorColor="@color/lg_primary"
        app:trackCornerRadius="4dp" />

    <LinearLayout
        android:id="@+id/state_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_3xl"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/state_icon_tile"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_icon_tile">

            <ImageView
                android:id="@+id/state_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_inbox" />
        </FrameLayout>

        <TextView
            android:id="@+id/state_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.LG.Subtitle"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/state_message"
            style="@style/LG.Text.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:maxWidth="320dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/state_action"
            style="@style/Widget.LG.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
