<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_3xl">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_logo_mark" />

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="@dimen/space_3xl"
        android:background="@drawable/bg_icon_tile">

        <ImageView
            android:id="@+id/blocking_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/lg_on_primary_container" />
    </FrameLayout>

    <TextView
        android:id="@+id/blocking_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.LG.Title"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/blocking_message"
        style="@style/LG.Text.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center"
        android:maxWidth="340dp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/blocking_progress"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:indeterminate="true"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/blocking_action"
        style="@style/Widget.LG.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2xl"
        android:minWidth="200dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/blocking_support"
        style="@style/Widget.LG.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/support_whatsapp"
        android:visibility="gone"
        app:icon="@drawable/ic_chat" />
</LinearLayout>
