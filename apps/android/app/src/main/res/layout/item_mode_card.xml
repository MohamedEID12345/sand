<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="150dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_s"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="128dp"
        android:orientation="vertical"
        android:padding="@dimen/space_m">

        <FrameLayout
            android:id="@+id/mode_tile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_tile">

            <ImageView
                android:id="@+id/mode_icon"
                android:layout_width="@dimen/icon_m"
                android:layout_height="@dimen/icon_m"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/mode_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.LG.Label"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/mode_desc"
            style="@style/LG.Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/mode_cost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.LG.Caption"
            android:textColor="?attr/colorSecondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
