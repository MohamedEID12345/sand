<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lg_background">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:layout_marginBottom="@dimen/space_s"
            android:background="@drawable/bg_hero"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_l">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_crown"
                app:tint="@color/brand_gold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plan_your_plan"
                    android:textAppearance="@style/TextAppearance.LG.Caption"
                    android:textColor="#CCFFFFFF" />

                <TextView
                    android:id="@+id/current_plan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LG.Subtitle"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/current_plan_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LG.Caption"
                    android:textColor="#B3FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabGravity="fill"
            app:tabMode="fixed" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_list_in"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_m"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_3xl" />

        <com.legalguide.app.ui.common.StateView
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <TextView
        style="@style/LG.Text.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:drawablePadding="@dimen/space_s"
        android:gravity="center_vertical"
        android:padding="@dimen/space_m"
        android:text="@string/checkout_secure_note"
        android:textSize="12sp"
        app:drawableStartCompat="@drawable/ic_lock"
        app:drawableTint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
