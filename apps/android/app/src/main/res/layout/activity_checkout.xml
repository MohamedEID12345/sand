<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <include
        android:id="@+id/app_bar"
        layout="@layout/view_appbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_2xl">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="@dimen/icon_tile"
                            android:layout_height="@dimen/icon_tile"
                            android:background="@drawable/bg_icon_tile"
                            android:backgroundTint="@color/tone_gold_bg">

                            <ImageView
                                android:id="@+id/item_icon"
                                android:layout_width="@dimen/icon_m"
                                android:layout_height="@dimen/icon_m"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                app:tint="@color/tone_gold" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_m"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/item_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.LG.Subtitle"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/item_subtitle"
                                style="@style/LG.Text.Muted"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/item_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.LG.Label"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/LG.Text.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/checkout_promo"
                android:layout_marginTop="@dimen/space_l"
                android:layout_marginBottom="@dimen/space_s" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/promo_layout"
                    style="@style/Widget.LG.TextInput"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_s"
                    android:layout_marginBottom="@dimen/space_m"
                    android:hint="@string/checkout_promo_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/promo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:textAlignment="viewStart" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/apply_promo"
                    style="@style/Widget.LG.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/checkout_apply"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <TextView
                style="@style/LG.Text.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/checkout_method"
                android:layout_marginTop="@dimen/space_l"
                android:layout_marginBottom="@dimen/space_s" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/methods_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/methods_empty"
                style="@style/LG.Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/checkout_no_methods"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/methods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:id="@+id/totals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_s"
                        android:layout_marginBottom="@dimen/space_s"
                        android:background="@color/lg_outline_variant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/checkout_total"
                            android:textAppearance="@style/TextAppearance.LG.Subtitle"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.LG.Subtitle"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/LG.Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/checkout_secure_note"
                android:layout_marginTop="@dimen/space_l"
                android:drawablePadding="@dimen/space_s"
                app:drawableStartCompat="@drawable/ic_lock"
                app:drawableTint="?attr/colorOnSurfaceVariant" />

            <TextView
                style="@style/LG.Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/checkout_terms_note"
                android:layout_marginTop="@dimen/space_s"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_m">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pay"
            style="@style/Widget.LG.Button.Gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/checkout_pay_default"
            app:icon="@drawable/ic_lock" />
    </LinearLayout>
</LinearLayout>
