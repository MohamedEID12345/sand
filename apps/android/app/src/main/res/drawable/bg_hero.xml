<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="315" android:startColor="#1B3A6B" android:endColor="#0B1630" android:type="linear" />
        </shape>
    </item>
    <item android:gravity="top|start" android:width="180dp" android:height="180dp" android:top="-70dp" android:start="-60dp">
        <shape android:shape="oval">
            <solid android:color="#14D4AF63" />
        </shape>
    </item>
    <item android:gravity="bottom|end" android:width="140dp" android:height="140dp" android:bottom="-60dp" android:end="-40dp">
        <shape android:shape="oval">
            <solid android:color="#10FFFFFF" />
        </shape>
    </item>
</layer-list>
