{
  "name": "sand-backend",
  "version": "1.0.0",
  "private": true,
  "description": "سند (Sand) — REST API (Node/Express) على Supabase (Postgres + Storage) + Gemini + Fawry + لوحة التحكم",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p . --noEmit",
    "setup": "tsc -p . && node dist/scripts/setup.js",
    "embed": "tsc -p . && node dist/scripts/embed.js",
    "process-queue": "tsc -p . && node dist/scripts/processQueue.js",
    "test:ai": "tsc -p . && node dist/scripts/testAi.js",
    "test:smoke": "tsc -p . && node dist/scripts/smoke.js",
    "test:supabase": "tsc -p . && node dist/scripts/testSupabase.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "docx": "^9.0.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "nodemailer": "^6.9.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.15",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
