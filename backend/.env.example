# ⚠️ ملف أسرار — لا يُرفع إلى GitHub ولا يوضع داخل التطبيق (APK).
# على Render/cPanel: ضع نفس المفاتيح كمتغيرات بيئة (Environment) بدل رفع هذا الملف.
NODE_ENV=production

# ── Supabase (Project Settings → API Keys) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# المفتاح السري (sb_secret_…) — للـ backend فقط. المفتاح العام (publishable) غير مستخدم.
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=sand-files

# العنوان العام للـ API بعد النشر (مثال Render: https://sand-api.onrender.com)
PUBLIC_BASE_URL=https://sand-api.onrender.com
# معالجة قوانين PDF داخل الـ API (يحتاج python3 + poppler + tesseract على نفس الجهاز). false = قائمة انتظار تُعالج بـ npm run process-queue
INGEST_INLINE=false

# ── Auth ──
JWT_SECRET=

# ── حساب مالك المنصة (يُنشأ بأمر npm run setup: مشرف SUPER + كل الخدمات مجانًا) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_PHONE=
ADMIN_RESET_PASSWORD=false

# ── الذكاء الاصطناعي — auto: Gemini ثم OpenAI ثم Groq ثم OpenRouter ──
AI_PROVIDER=auto
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ── Fawry — رابط الإشعارات (Webhook):  <PUBLIC_BASE_URL>/api/v1/webhooks/fawry ──
FAWRY_BASE_URL=https://atfawry.fawrystaging.com
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=
FAWRY_RETURN_URL=legalguide://payment/return

# ── SMTP (رموز استعادة كلمة المرور) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@legalguide.app
